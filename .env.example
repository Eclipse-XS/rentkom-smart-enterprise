# ==============================================================================
# RENTKOM SMART ENTERPRISE: ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and adjust variables as needed.
# In DEMO mode, no secrets are required.
# ==============================================================================

# Environment mode: demo | development | production
ENVIRONMENT=demo

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lab4_real_estate
POSTGRES_HOST_PORT=5432

# Business Core API
API_PORT=8000
NOTIFICATION_PROVIDER=mock
ADMIN_EMAIL=admin@rentkom.lviv.ua

# Internal Microservice & Administrative Authentication (Required for Connected/Production Mode)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=your_secure_random_internal_api_key_32_bytes_hex
ADMIN_API_KEY=your_secure_random_admin_api_key_32_bytes_hex

# Test Webhook Secret (Permitted only in demo/test mode; forbidden in production)
TEST_WEBHOOK_SECRET=your_secure_random_test_webhook_secret_here
ALLOW_TEST_WEBHOOK=true

# External SMTP (Required when NOTIFICATION_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10.0

# Telegram Bot (Required in Connected Mode for Live Bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# CORS Allowed Origins (Comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:5678,http://localhost:8000

# Disposable Test Database (Used ONLY by automated integration tests; must include 'test' in DB name)
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5439/rentkom_test

# n8n Webhook Ingress (Required in Connected Mode)
WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/

# Grafana Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# AI / RAG Subsystem
OLLAMA_HOST=ollama
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_EMBED_MODEL=mxbai-embed-large:latest
RAG_NUM_PREDICT=384
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_real_estate
