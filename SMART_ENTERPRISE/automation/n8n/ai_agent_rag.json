        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { chat_id: $('Telegram Trigger').first().json.message.chat.id } }}",
        "options": {
          "timeout": 5000
        }
      },
      "id": "50c1e6e1-0a37-44a9-9000-200000000012",
