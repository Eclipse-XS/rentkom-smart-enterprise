        }
      }
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                },
                "conditions": [
                  {
                    "id": "lab6-route-start",
                    "leftValue": "={{ $json.message.text }}",
                    "rightValue": "/start",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "/start"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "AI запит",
          "allMatchingOutputs": false
        }
      },
      "id": "50c1e6e1-0a37-44a9-9000-200000000009",
      "name": "Route Message",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').first().json.message.chat.id }}",
        "text": "Вітаю. Я інформаційний помічник агентства нерухомості «Рентком». Можу відповісти за матеріалами бази знань про купівлю житла, перевірку документів, підписання угод, оренду, послуги агентства та конфіденційність.",
        "additionalFields": {
          "appendAttribution": false
        },
        "replyMarkup": "replyKeyboardRemove",
        "replyKeyboardRemove": {
          "remove_keyboard": true
        }
      },
      "id": "50c1e6e1-0a37-44a9-9000-200000000010",
      "name": "Start Greeting",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        680,
        180
      ],
      "credentials": {
        "telegramApi": {
          "id": "egDthAT3oVlnSRjQ",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Telegram Trigger').first().json.message.text }}",
        "options": {
          "systemMessage": "Ти інформаційний помічник агентства нерухомості Рентком. Для кожного запиту про купівлю, оренду, перевірку документів, підписання договорів, послуги або конфіденційність спочатку викликай інструмент knowledge_base_real_estate. Формуй пошуковий запит із точною назвою релевантного документа: Пам’ятка для покупця; Порядок підписання договору; Керівництво з перевірки документів; Шаблон договору оренди житла; Опис послуг агентства Рентком; Правила конфіденційності. Відповідай лише на підставі знайдених фрагментів. Якщо потрібних відомостей немає, напиши: На жаль, я не маю такої інформації у базі знань. Не вигадуй фактів і не видавай відповідь за юридичну консультацію. Відповідай українською, стисло і конкретно.",
          "returnIntermediateSteps": true,
          "maxIterations": 5,
          "enableStreaming": false
        }
      },
      "id": "50c1e6e1-0a37-44a9-9000-200000000002",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        680,
        360
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:5680/start",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { chat_id: $('Telegram Trigger').first().json.message.chat.id, interval: 4, max_seconds: 240 } }}",
        "options": {
          "timeout": 5000
        }
      },
      "id": "50c1e6e1-0a37-44a9-9000-200000000011",
      "name": "Start Typing Indicator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        500
      ],
      "onError": "continueRegularOutput"
