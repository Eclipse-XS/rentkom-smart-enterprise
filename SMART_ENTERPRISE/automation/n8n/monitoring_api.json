    {
      "parameters":{"jsCode":"const rows = $input.all().map(i => i.json);\nconst groups = new Map();\nfor (const row of rows) {\n  const raw = String(row['Дата звернення'] ?? '').trim();\n  const m = raw.match(/^(\\d{2})[.\\/-](\\d{2})[.\\/-](\\d{4})$/);\n  const date = m ? `${m[3]}-${m[2]}-${m[1]}` : raw.slice(0,10);\n  const service = Number(String(row['Оцінка сервісу'] ?? '').replace(',', '.'));\n  const realtor = Number(String(row['Оцінка рієлтора'] ?? '').replace(',', '.'));\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(date) || !Number.isFinite(service) || !Number.isFinite(realtor)) continue;\n  const g = groups.get(date) ?? {date, service_sum:0, realtor_sum:0, count:0};\n  g.service_sum += service; g.realtor_sum += realtor; g.count += 1; groups.set(date,g);\n}\nreturn [...groups.values()].sort((a,b)=>a.date.localeCompare(b.date)).map(g => ({json:{date:g.date,service_rating:Number((g.service_sum/g.count).toFixed(2)),realtor_rating:Number((g.realtor_sum/g.count).toFixed(2)),responses:g.count}}));"},
