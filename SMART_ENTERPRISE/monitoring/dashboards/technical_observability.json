      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS value FROM notification_outbox WHERE status = 'PROVIDER_ACCEPTED';",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
